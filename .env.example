VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_ADMIN_EMAIL=

# Required for the admin media upload feature (src/services/mediaService.js).
# VITE_CLOUDINARY_CLOUD_NAME: your Cloudinary cloud name (not secret).
# VITE_CLOUDINARY_UPLOAD_PRESET: an UNSIGNED upload preset configured in the
#   Cloudinary console (Settings -> Upload -> Upload presets), restricted to
#   the "photography/" folder and image formats only. Never put your
#   Cloudinary API secret here or anywhere in this project.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
