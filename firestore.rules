rules_version = '2';

// Firestore security rules for Bhavana Clicks.
//
// Firebase Authentication (Email/Password) is now enabled, with exactly two
// admin accounts created directly in the Firebase Console. The app has no
// self-registration UI, but that alone does NOT make `request.auth != null`
// a safe stand-in for "is an admin" — Firebase's Identity Toolkit sign-up
// endpoint is reachable by anyone who knows the project's public apiKey
// (which is, by design, public), regardless of whether the app exposes a
// signup form. So instead of trusting "signed in", isAuthorizedAdmin() below
// checks the signed-in user's verified email against an explicit allowlist.
//
// This is deliberately the smallest mechanism that closes that gap: no
// Cloud Functions/custom claims (which would require the paid Blaze plan),
// no separate `admins` collection to seed. The tradeoff is that adding or
// changing an admin means editing this list and redeploying rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorizedAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'bhavanaclicks@gmail.com',
          'harshithsham8899@gmail.com'
        ];
    }

    function isValidStatus(status) {
      return status in ['new', 'contacted', 'confirmed', 'archived'];
    }

    // Legacy collection — superseded by website_images (Phase 2). Left
    // exactly as-is (still publicly readable, still admin-unwritable) so
    // its existing data isn't destroyed; nothing in the app writes to it
    // going forward.
    match /about_images/{imageId} {
      allow read: if true;
      allow write: if false;
    }

    // Phase 2 media system (src/services/mediaService.js). Public visitors
    // may read image references (needed by every public page that shows a
    // managed image); only authorized admins may create/update them.
    // "Removing" an image (mediaService.removeWebsiteImage) is implemented
    // as an UPDATE — it sets imageUrl/publicId to null and isActive to
    // false rather than deleting the document — so it's already covered by
    // the update rule below. Actual Firestore document deletion, and
    // Cloudinary asset deletion, are both still intentionally unimplemented
    // and stay denied for everyone.
    match /website_images/{slotId} {
      allow read: if true;
      allow create, update: if isAuthorizedAdmin();
      allow delete: if false;
    }

    // Written by src/services/galleryService.js, which is not currently
    // called from any page in the app, and not read anywhere either.
    // Deny everything until it's actually wired up.
    match /gallery/{docId} {
      allow read, write: if false;
    }

    // Dynamic post management (src/services/postsService.js) — Home
    // Featured, Weddings, Couples, Elopement Guides list entries. Unlike
    // website_images, these are genuine list items with no slot identity
    // to preserve, so real deletion (not a soft isActive flag) is the
    // correct model: admins may create/update/delete the Firestore
    // document. The Cloudinary asset itself is still never deleted by any
    // code path, matching the rest of the media system.
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // Public enquiry submission (src/services/enquiryService.js).
    // Visitors may create an enquiry but never read, modify, or delete any
    // enquiry — including their own. Authorized admins may read enquiries,
    // and may update ONLY the `status` field to one of the four valid
    // values (src/services/enquiryService.js: updateEnquiryStatus) — every
    // other field must stay untouched, enforced by the affectedKeys()
    // check below rather than trusted from the client. Deletion is not
    // implemented anywhere yet, so it stays denied for everyone.
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read: if isAuthorizedAdmin();
      allow update: if isAuthorizedAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && isValidStatus(request.resource.data.status);
      allow delete: if false;
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
